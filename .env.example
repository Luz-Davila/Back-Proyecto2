# Copiar a .env y completar. No subir .env al repositorio.

# Base de datos (Supabase Postgres)
# Usar la cadena de conexión del panel de Supabase (Connect).
DATABASE_URL=
DATABASE_SSL=true

# PostgreSQL exclusivo de pruebas. Nunca usar la BD de desarrollo o producción.
# Requerido por npm run test:sessions; no se usa DATABASE_URL como alternativa.
TEST_DATABASE_URL=
TEST_DATABASE_SSL=false

# Supabase Auth y Storage
# SUPABASE_URL: URL del proyecto, por ejemplo https://<proyecto>.supabase.co
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=question-images
# Solo backend. Nunca en React ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# API del juego
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Asistente de cuestionarios (DeepSeek). Solo backend; nunca usar VITE_ para la clave.
# Copiar estas variables a .env y completar la clave allí, sin compartirla ni subirla.
# Sin clave, solo el chat devuelve 503; el editor manual sigue disponible.
DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash (identificador oficial de la API).
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000

# Usuario de demostración (solo desarrollo local; no subir credenciales reales)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# OpenTelemetry (colector OTLP)
OTEL_SERVICE_NAME=profelink-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# En Grafana Cloud, pegar aquí el valor entregado por el panel; nunca subirlo al repositorio.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <credencial>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf  # o http/json; grpc no está soportado
