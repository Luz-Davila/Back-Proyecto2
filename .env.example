# Copiar a .env y completar. No subir .env al repositorio.

# Base de datos (Supabase Postgres)
# Usar la cadena de conexión del panel de Supabase (Connect).
DATABASE_URL=
DATABASE_SSL=true

# Supabase Auth y Storage
# SUPABASE_URL: URL del proyecto, por ejemplo https://<proyecto>.supabase.co
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=question-images
# Solo backend. Nunca en React ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# API del juego
PORT=3000
CORS_ORIGIN=http://localhost:5173

# OpenTelemetry (colector OTLP)
OTEL_SERVICE_NAME=profelink-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
